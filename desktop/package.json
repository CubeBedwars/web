{
  "name": "voxel-bedwars-desktop",
  "version": "1.0.0",
  "description": "Voxel Bedwars Desktop Standalone Client with native windowing and LAN multiplayer support",
  "main": "main.cjs",
  "scripts": {
    "start": "electron main.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "io.bedwars.voxel.desktop",
    "productName": "Voxel Bedwars",
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "../dist/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
